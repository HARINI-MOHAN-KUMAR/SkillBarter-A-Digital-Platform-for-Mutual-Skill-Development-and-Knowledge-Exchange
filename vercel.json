{
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "vite",
      "outputDirectory": "dist"
    },
    "backend": {
      "root": "backend/",
      "entrypoint": "app:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
